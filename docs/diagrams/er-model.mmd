erDiagram
    GENRES  ||--o{ BOOKS : "classifies"
    AUTHORS ||--o{ BOOKS : "writes"
    BOOKS   ||--o{ LOANS : "is lent in"
    MEMBERS ||--o{ LOANS : "borrows in"

    GENRES {
        bigint id PK
        varchar name UK
        varchar description
    }
    AUTHORS {
        bigint id PK
        varchar first_name
        varchar last_name
        varchar country
        int birth_year
    }
    BOOKS {
        bigint id PK
        varchar title
        bigint author_id FK
        bigint genre_id FK
        varchar isbn UK
        int published_year
        int quantity
        varchar shelf_location
    }
    MEMBERS {
        bigint id PK
        varchar first_name
        varchar last_name
        varchar email UK
        varchar phone
        date registered_on
    }
    LOANS {
        bigint id PK
        bigint book_id FK
        bigint member_id FK
        date loan_date
        date due_date
        date return_date
    }
